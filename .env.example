# Postgres connection string. Required in production; local dev without it
# falls back to embedded PGlite in .data/.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Long random string. Signs contractor sessions and the customer booking links,
# so without it nobody can sign in and no manage-booking link validates.
MARKETPLACE_SECRET=generate-a-long-random-string

# Gates /admin. Dev falls back to "admin"; production without it is open.
ADMIN_PASSWORD=choose-a-strong-admin-password

# Public origin of this client's site, no trailing slash. Without it the
# tappable link inside job-offer texts and customer emails is missing.
MARKETPLACE_BASE_URL=https://www.freshforlessovencleaning.co.uk

# SMS (Twilio) — the channel that decides who wins a first-to-accept job.
# All three are needed; without them texts are recorded in the admin
# notification log but never delivered.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+447700000000

# Email (Resend) — backup channel for job offers and customer confirmations.
# Both are needed; without them emails are logged but never delivered.
RESEND_API_KEY=
MARKETPLACE_FROM_EMAIL=bookings@freshforlessovencleaning.co.uk

# Local development only — where PGlite keeps its database files. Defaults to
# .data/marketplace in the project. Set it to a path on local disk if the
# project lives somewhere that can't create or lock files (a synced folder or
# a sandboxed mount), which otherwise surfaces as "PGlite failed to initialize".
MARKETPLACE_DATA_DIR=
